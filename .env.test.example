# ============================================================================
# JobMatch AI - Test Environment Variables
# ============================================================================
# Copie este arquivo para .env.test para executar os testes
# ============================================================================

NODE_ENV=test

# Database
DATABASE_URL="mysql://test_user:test_password@localhost:3306/jobmatch_test"

# JWT
JWT_SECRET="test_jwt_secret_for_testing_only"

# LLM API (pode usar mock)
BUILT_IN_FORGE_API_KEY="test_api_key"
BUILT_IN_FORGE_API_URL="https://api.openai.com/v1"

# S3 Storage (pode usar mock ou MinIO local)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="test"
S3_SECRET_KEY="test"
S3_BUCKET="test-bucket"
S3_REGION="us-east-1"

# OAuth (opcional para testes)
OAUTH_SERVER_URL="https://api.manus.im"
OAUTH_CLIENT_ID=""
OAUTH_CLIENT_SECRET=""

# Owner
OWNER_NAME="Test User"
OWNER_OPEN_ID="test"
