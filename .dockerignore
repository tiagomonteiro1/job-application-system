# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
.next/
out/

# Development
.env
.env.local
.env.*.local
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Git
.git/
.gitignore
.gitattributes

# Documentation
README.md
INSTALACAO.md
*.md
docs/

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# Testing
coverage/
.nyc_output/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__/
__mocks__/

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
.circleci/

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.swp

# OS files
Thumbs.db
.DS_Store

# Uploads (serão gerenciados por volumes)
uploads/
