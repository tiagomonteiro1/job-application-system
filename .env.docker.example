# ============================================================================
# JobMatch AI - Docker Environment Variables
# ============================================================================
# Copie este arquivo para .env.docker e configure as variáveis
# Uso: docker-compose --env-file .env.docker up
# ============================================================================

# MySQL
MYSQL_ROOT_PASSWORD=rootpassword_change_me
MYSQL_PASSWORD=jobmatch_password_change_me

# MinIO (S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123_change_me

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# LLM API (OBRIGATÓRIO)
BUILT_IN_FORGE_API_KEY=sk-your-openai-api-key-here
BUILT_IN_FORGE_API_URL=https://api.openai.com/v1
VITE_FRONTEND_FORGE_API_KEY=sk-your-openai-api-key-here
VITE_FRONTEND_FORGE_API_URL=https://api.openai.com/v1

# OAuth (opcional)
OAUTH_SERVER_URL=https://api.manus.im
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Owner
OWNER_NAME=Admin
OWNER_OPEN_ID=admin
